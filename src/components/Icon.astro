---
import type { IconName } from '../lib/icons';

interface Props {
  name: IconName;
}

const { name } = Astro.props;
---

<svg
  class="icon"
  viewBox="0 0 16 16"
  aria-hidden="true"
  fill="none"
  stroke="currentColor"
  stroke-width="1.4"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  {
    name === 'mail' && (
      <>
        <rect x="1.8" y="3.3" width="12.4" height="9.4" rx="1.2" />
        <path d="M2.3 4.2 8 8.5l5.7-4.3" />
      </>
    )
  }
  {
    name === 'phone' && (
      <path d="M5 2.6h1.8c.3 0 .5.3.5.6L7 5.1a.6.6 0 0 1-.4.4l-.9.3a6.4 6.4 0 0 0 4.5 4.5l.3-.9a.6.6 0 0 1 .4-.4l1.9-.3c.3 0 .6.2.6.5v1.8A1.4 1.4 0 0 1 12 13 8.6 8.6 0 0 1 3 4a1.4 1.4 0 0 1 2-1.4z" />
    )
  }
  {
    name === 'github' && (
      <path
        fill="currentColor"
        stroke="none"
        d="M8 1.15a6.85 6.85 0 0 0-2.16 13.36c.34.06.46-.15.46-.33v-1.17c-1.89.41-2.29-.81-2.29-.81-.31-.78-.76-1-.76-1-.62-.42.05-.42.05-.42.69.05 1.05.7 1.05.7.61 1.04 1.6.74 1.98.57.06-.45.24-.75.43-.92-1.51-.17-3.1-.76-3.1-3.36 0-.74.26-1.35.7-1.82-.07-.17-.3-.88.07-1.83 0 0 .57-.18 1.87.7a6.5 6.5 0 0 1 3.4 0c1.3-.88 1.87-.7 1.87-.7.37.95.14 1.66.07 1.83.44.47.7 1.08.7 1.82 0 2.61-1.59 3.19-3.11 3.36.25.22.47.63.47 1.27v1.88c0 .18.12.4.47.33A6.85 6.85 0 0 0 8 1.15z"
      />
    )
  }
  {name === 'introduce' && <path d="M2.6 4.1h10.8M2.6 8h10.8M2.6 11.9h6.4" />}
  {name === 'projects' && <path d="M2.1 4.3h4.1l1.15 1.25h6.55V12.6H2.1z" />}
  {
    name === 'career' && (
      <>
        <rect x="2" y="5.1" width="12" height="8" rx="1" />
        <path d="M6 5.1V3.7h4v1.4M2 8.6h12" />
      </>
    )
  }
  {
    name === 'language' && (
      <>
        <circle cx="8" cy="8" r="5.25" />
        <path d="M2.75 8h10.5M8 2.75c1.55 1.65 2.35 3.35 2.35 5.25S9.55 11.6 8 13.25C6.45 11.6 5.65 9.9 5.65 8S6.45 4.4 8 2.75" />
      </>
    )
  }
  {
    name === 'stack' && (
      <path d="M8 2.3 13.6 5.4 8 8.5 2.4 5.4zM2.7 8.1 8 11.1l5.3-3M2.7 10.5 8 13.5l5.3-3" />
    )
  }
  {
    name === 'agent' && (
      <>
        <circle cx="4" cy="11.2" r="1.55" />
        <circle cx="12" cy="11.2" r="1.55" />
        <circle cx="8" cy="4.1" r="1.55" />
        <path d="M5.3 10.2 6.9 5.5M10.7 10.2 9.1 5.5M5.6 11.2h4.8" />
      </>
    )
  }
  {
    name === 'backend' && (
      <>
        <rect x="2.3" y="2.3" width="11.4" height="4.1" rx="0.8" />
        <rect x="2.3" y="9.5" width="11.4" height="4.1" rx="0.8" />
        <circle cx="4.6" cy="4.35" r="0.5" fill="currentColor" stroke="none" />
        <circle cx="4.6" cy="11.55" r="0.5" fill="currentColor" stroke="none" />
      </>
    )
  }
  {
    name === 'data' && (
      <>
        <ellipse cx="8" cy="4" rx="4.7" ry="1.65" />
        <path d="M3.3 4v8c0 .9 2.1 1.65 4.7 1.65s4.7-.75 4.7-1.65V4" />
        <path d="M3.3 8c0 .9 2.1 1.65 4.7 1.65s4.7-.75 4.7-1.65" />
      </>
    )
  }
  {
    name === 'book' && (
      <>
        <path d="M1.8 3.5h4.7A2.2 2.2 0 0 1 8 5.1v8a2 2 0 0 0-1.5-.6H1.8z" />
        <path d="M14.2 3.5H9.5A2.2 2.2 0 0 0 8 5.1v8c.45-.35.95-.6 1.5-.6h4.7z" />
      </>
    )
  }
  {
    name === 'chat' && (
      <>
        <path d="M2.3 3.1h11.4v7.3H7.3L4.5 13v-2.6H2.3z" />
        <path d="M4.8 6h6.4M4.8 8.2h3.6" />
      </>
    )
  }
  {
    name === 'people' && (
      <>
        <circle cx="5.3" cy="4.7" r="1.5" />
        <circle cx="10.5" cy="5.2" r="1.2" />
        <path d="M2.6 11.3c.45-1.75 1.65-2.55 2.7-2.55s2.25.8 2.7 2.55" />
        <path d="M9.4 9.5c.35-.4.9-.65 1.45-.65 1 0 1.85.7 2.15 1.8" />
        <path d="M10.5 12.3 11.7 13.5 14.2 11" />
      </>
    )
  }
  {
    name === 'bus' && (
      <>
        <rect x="2.5" y="3" width="11" height="7.3" rx="1.3" />
        <path d="M2.5 6.3h11" />
        <circle cx="5.2" cy="12.3" r="1.05" />
        <circle cx="10.8" cy="12.3" r="1.05" />
      </>
    )
  }
  {
    name === 'qa' && (
      <>
        <path d="M2.6 6.4h2.2l5.5-2.7v8.6L4.8 9.4H2.6z" />
        <path d="M4.7 9.5v1.9c0 .4.35.7.75.55l1.15-.35" />
        <path d="M12 6.1a2.35 2.35 0 0 1 0 3.6" />
      </>
    )
  }
  {
    name === 'clipboard' && (
      <>
        <rect x="3.4" y="3.3" width="9.2" height="10.3" rx="1" />
        <path d="M6.2 2.3h3.6v1.8H6.2z" />
        <path d="M5.6 7.2h4.8M5.6 9.4h4.8M5.6 11.4h3" />
      </>
    )
  }
  {
    name === 'cap' && (
      <>
        <path d="M8 2.3 14.5 5.5 8 8.7 1.5 5.5z" />
        <path d="M4.3 7.1v3.1c0 .15 1.55 1.85 3.7 1.85s3.7-1.7 3.7-1.85V7.1" />
        <path d="M14.5 5.7v3.6" />
      </>
    )
  }
</svg>
