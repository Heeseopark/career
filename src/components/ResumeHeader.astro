---
import ContactRow from './ContactRow.astro';

interface Props {
  name: string;
  role: string;
  email: string;
  phone: string;
  github: string;
  githubLabel: string;
}

const { name, role, email, phone, github, githubLabel } = Astro.props;
---

<header>
  <h1>{name}</h1>
  <p class="role">{role}</p>
  <ContactRow email={email} phone={phone} github={github} githubLabel={githubLabel} />
</header>
