---
import type { MarkIcon } from '../lib/icons';
import { richText } from '../lib/inline';
import Mark from './Mark.astro';

interface CareerPoint {
  text: string;
  children?: string[];
}

interface Props {
  items: { title: string; icon?: MarkIcon; badge?: string; points: CareerPoint[] }[];
}

const { items } = Astro.props;
---

<ul class="career">
  {
    items.map((item) => (
      <li>
        <p class="career-title">
          {item.icon && <Mark name={item.icon} />}
          <span set:html={richText(item.title)} />
          {item.badge && <span class="badge">{item.badge}</span>}
        </p>
        <ul>
          {item.points.map((point) => (
            <li>
              <span class="line" set:html={richText(point.text)} />
              {point.children && point.children.length > 0 && (
                <ul>
                  {point.children.map((child) => (
                    <li set:html={richText(child)} />
                  ))}
                </ul>
              )}
            </li>
          ))}
        </ul>
      </li>
    ))
  }
</ul>
