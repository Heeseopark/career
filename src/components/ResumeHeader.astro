---
import ContactRow from './ContactRow.astro';

interface Props {
  name: string;
  role: string;
  email: string;
  phone: string;
  github: string;
  githubLabel: string;
}

const { name, role, email, phone, github, githubLabel } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const portfolioHref = `${base}portfolio/`;
---

<header>
  <h1>{name}</h1>
  <p class="role">{role}</p>
  <ContactRow
    email={email}
    phone={phone}
    github={github}
    githubLabel={githubLabel}
    portfolioHref={portfolioHref}
  />
</header>
