---
import { getCollection } from 'astro:content';
import type { ImageIconName } from '../../lib/icons';
import Editorial from '../../layouts/Editorial.astro';
import Mark from '../../components/Mark.astro';
import Icon from '../../components/Icon.astro';

const items = (await getCollection('portfolio')).sort((a, b) => a.data.order - b.data.order);
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const resumeHref = `${base}resume/samil/`;

const fallbackIcon = {
  'allen-mcp': 'agent',
  lis: 'data',
} as const;
---

<Editorial title="포트폴리오 | 박희서" description="박희서 포트폴리오. 알렌, Allen MCP, LIS, 무물, 수양회.">
  <main class="page">
    <header>
      <p class="kicker"><a href={resumeHref}>이력서</a></p>
      <h1>포트폴리오</h1>
      <p class="role">문제, 결정, 결과를 같은 순서로 적었습니다.</p>
    </header>
    <ol class="cards">
      {
        items.map((item) => {
          const glyph = fallbackIcon[item.id as keyof typeof fallbackIcon];
          return (
            <li>
              <a class="card" href={`${base}portfolio/${item.id}/`}>
                {item.data.icon ? (
                  <Mark name={item.data.icon as ImageIconName} />
                ) : (
                  glyph && <Icon name={glyph} />
                )}
                <span class="card-title">{item.data.title}</span>
                <span class="meta">{item.data.role}</span>
              </a>
            </li>
          );
        })
      }
    </ol>
  </main>
</Editorial>
